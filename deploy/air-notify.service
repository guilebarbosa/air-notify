# systemd user service for Linux / Raspberry Pi. Rendered (@APP_DIR@ = the clone) and installed by deploy/pi-service.sh.
[Unit]
Description=air-notify: AirTag arrive/leave notifications

[Service]
Type=simple
ExecStart=@APP_DIR@/.venv/bin/air-notify run
# Like the macOS LaunchAgent: restart only after a crash (exit 0 means "needs you"),
# at most every 5 minutes so a crash loop can't hammer Apple.
Restart=on-failure
RestartSec=300
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
