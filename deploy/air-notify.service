# systemd user service for Linux / Raspberry Pi. Installed by deploy/pi-service.sh.
[Unit]
Description=air-notify: AirTag arrive/leave notifications
Documentation=https://github.com/guilebarbosa/air-notify

[Service]
Type=simple
ExecStart=%h/air-notify/.venv/bin/air-notify run
# Like the macOS LaunchAgent: restart only after a crash (exit 0 means "needs you"),
# at most every 5 minutes so a crash loop can't hammer Apple.
Restart=on-failure
RestartSec=300
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
